# Copy to .env and fill in real values for local dev. .env is gitignored — never
# commit real secrets. Every var below has a dev-only fallback (src/config/require-env.ts)
# used automatically when NODE_ENV is unset/development/test, so none of these are
# required just to run `npm run start:dev` — only outside dev/test (a real deployment)
# does a missing one refuse to boot.

NODE_ENV=development

# HTTP port the app listens on.
PORT=3000

# Real Postgres connection string. Falls back to the docker-compose dev Postgres
# (postgresql://lattice:lattice@localhost:5432/lattice) if unset.
DATABASE_URL=postgresql://lattice:lattice@localhost:5432/lattice

# Real Redis connection string (rediss:// for TLS, e.g. Upstash). Falls back to the
# docker-compose dev Redis (redis://localhost:6379) if unset.
REDIS_URL=redis://localhost:6379

# JWT signing secret — must be a real, random, secret value outside local dev.
JWT_SECRET=dev-only-insecure-secret-do-not-use-in-production

# Comma-separated list of origins allowed to call the REST API from a browser
# (CORS). Add a new frontend origin here (and in the real deployment's env vars) as
# needed — no code change required. Doesn't affect the /sync WebSocket gateway,
# which isn't subject to CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# How often SnapshotSchedulerService writes a doc snapshot during sustained editing
# (ms). Tuned via SCRUM-58's load test — see load-test/README.md.
SNAPSHOT_INTERVAL_MS=1000

# Leading+trailing throttle window for cursor position broadcasts (ms). Tuned via
# SCRUM-58's load test — see load-test/README.md.
CURSOR_THROTTLE_MS=75

# Rate limit for POST /auth/register and POST /auth/login, tracked per (IP, route).
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_TTL_MS=60000
